@page "/_messages"

<h3>MessagesList</h3>

@inject HttpClient Http

<div class="messages-container">
    <h3>Список сообщений</h3>
    @if (_messages == null)
    {
        <p><em>Загрузка...</em></p>
    }
    else if (!_messages.Any())
    {
        <p>Сообщений пока нет.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var msg in _messages)
            {
                <li class="list-group-item">
                    <div>
                        <span class="text-muted small">(@msg.Timestamp.ToString("g"))</span>
                    </div>
                    <div>@msg.Content</div>
                </li>
            }
        </ul>
    }
</div>
@code {
    private List<MessageDTO> _messages;

    protected override async Task OnInitializedAsync()
    {
        await LoadMessages();
    }

    public async Task RefreshAsync()
    {
        await LoadMessages();
        StateHasChanged();
    }

    private async Task LoadMessages()
    {
        try
        {
            _messages = await Http.GetFromJsonAsync<List<MessageDTO>>("api/message/get");
        }
        catch (Exception ex)
        {
            _messages = new List<MessageDTO>();
        }
    }
}
